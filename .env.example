# Prodrion configuration. Copy to .env and fill in.
# All variables are prefixed PRODRION_ and read by config.Settings.
# Values shown are the defaults; blank means "feature disabled".

# ---- Environment ----
# development | production | test
# In production the process refuses to start on an incoherent config.
PRODRION_ENVIRONMENT=development

# ---- Observability ----
PRODRION_SERVICE_NAME=prodrion
PRODRION_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
PRODRION_LOG_FORMAT=text                # "json" in production
PRODRION_SENTRY_DSN=                    # set to enable Sentry error reporting

# ---- Core API service ----
PRODRION_API_HOST=127.0.0.1          # use 0.0.0.0 in production, behind nginx
PRODRION_API_PORT=8000
PRODRION_DB_PATH=feedback_platform.db

# ---- API security ----
# Bearer token for the admin/query endpoints (/query, /revenue-impact,
# /bootstrap-taxonomy, /taxonomy, /import-users) and the repo-agent server.
# Required in production. Blank in dev = auth disabled (logs a warning).
PRODRION_API_AUTH_TOKEN=
# Shared secret required in the X-Webhook-Secret header on POST /webhook/feedback.
# Required in production.
PRODRION_WEBHOOK_SECRET=
# Slack signing secret for POST /webhook/slack signature verification.
# Blank in dev = check skipped; in production the Slack endpoint is disabled.
PRODRION_SLACK_SIGNING_SECRET=
# Max accepted request body size in bytes (default 1 MiB).
PRODRION_MAX_REQUEST_BYTES=1048576
# Hard row cap + wall-clock budget for the /query (text-to-SQL) endpoint.
PRODRION_QUERY_ROW_CAP=100
PRODRION_QUERY_TIMEOUT_SECONDS=5.0
# repo-agent may only analyse directories under this base (blank = bundled repo-agent/).
PRODRION_REPO_AGENT_ALLOWED_BASE=

# ---- GitHub App (repo read + issue/PR creation) ----
PRODRION_GITHUB_API_URL=https://api.github.com
PRODRION_GITHUB_APP_ID=
PRODRION_GITHUB_APP_PRIVATE_KEY=        # PEM contents, or a path to a .pem file
PRODRION_GITHUB_WEBHOOK_SECRET=
PRODRION_GITHUB_CLONE_MAX_BYTES=50000000
PRODRION_GITHUB_CLONE_TIMEOUT_SECONDS=120
PRODRION_GITHUB_CLONE_DIR=var/gh-clones

# ---- Credits / billing ----
PRODRION_CREDITS_ENABLED=false          # true = enforce credit balances
PRODRION_DEFAULT_WORKSPACE_ID=default
PRODRION_CREDITS_PER_FEEDBACK=1
PRODRION_CREDITS_PER_REPO_ANALYSIS=25

# ---- Background worker / job queue ----
PRODRION_WORKER_POLL_INTERVAL_SECONDS=1.0
PRODRION_JOB_MAX_ATTEMPTS=5
PRODRION_JOB_BACKOFF_BASE_SECONDS=5.0     # retry delay = base * 2**(attempt-1)
PRODRION_JOB_BACKOFF_MAX_SECONDS=3600.0
# true = run the worker loop + scheduler inside the API process (dev only);
# in production run `python worker.py` as a separate service.
PRODRION_INLINE_WORKER=false

# ---- LLM / embeddings ----
# Provider for BOTH generation and embeddings: gemini | ollama | fake
# ("fake" is test-only and rejected in production).
PRODRION_LLM_PROVIDER=gemini

# Gemini (free-tier API) — required when PRODRION_LLM_PROVIDER=gemini
PRODRION_GEMINI_API_KEY=
PRODRION_GEMINI_MODEL=gemini-2.5-flash
PRODRION_GEMINI_EMBED_MODEL=text-embedding-004

# Ollama (local) — used when PRODRION_LLM_PROVIDER=ollama
PRODRION_OLLAMA_URL=http://localhost:11434/api/generate
PRODRION_OLLAMA_MODEL=llama3.2:latest
PRODRION_OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- Tuning knobs ----
PRODRION_SIMILARITY_THRESHOLD=0.85   # 0..1, feedback<->Jira auto-link cutoff
PRODRION_VELOCITY_SPIKE_MULT=2.0     # week-over-week multiple that fires an alert
PRODRION_DRIFT_MIN_CLUSTER_SIZE=3    # HDBSCAN min cluster size for drift detection

# ---- Demo / bootstrap ----
PRODRION_LOAD_DEMO_DATA=false        # load demo Jira tickets when Jira is unconfigured
PRODRION_TAXONOMY_BOOTSTRAP_URL=     # product docs URL; taxonomy is auto-built from it when empty

# ---- Slack (alerts + ingestion) ----
PRODRION_SLACK_BOT_TOKEN=            # xoxb-...
PRODRION_SLACK_ALERT_CHANNEL=#alerts

# ---- Zendesk (if set, EMAIL and TOKEN are required) ----
PRODRION_ZENDESK_URL=                # https://yourco.zendesk.com
PRODRION_ZENDESK_EMAIL=
PRODRION_ZENDESK_TOKEN=

# ---- App Store / Play Store ----
PRODRION_APP_STORE_APP_ID=           # e.g. 1234567890
PRODRION_PLAY_STORE_APP_ID=          # e.g. com.example.app

# ---- Jira (if set, EMAIL and TOKEN are required) ----
PRODRION_JIRA_URL=                   # https://yourco.atlassian.net
PRODRION_JIRA_EMAIL=
PRODRION_JIRA_TOKEN=
PRODRION_JIRA_PROJECT=PROJ

# ---- HubSpot ----
PRODRION_HUBSPOT_API_KEY=

# ---- Feedback -> goal -> repo-agent connector ----
PRODRION_FEEDBACK_API_URL=http://localhost:8000
PRODRION_REPO_AGENT_URL=http://localhost:7845
PRODRION_GOAL_MIN_CLUSTER_SIZE=2
