# Prodrion configuration. Copy to .env and fill in.
# All variables are prefixed PRODRION_ and read by config.Settings.
# Values shown are the defaults; blank means "feature disabled".

# ---- Environment ----
# development | production | test
# In production the process refuses to start on an incoherent config.
PRODRION_ENVIRONMENT=development

# ---- Observability ----
PRODRION_SERVICE_NAME=prodrion
PRODRION_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
PRODRION_LOG_FORMAT=text                # "json" in production
# Set to enable Sentry error reporting.
PRODRION_SENTRY_DSN=

# ---- Core API service ----
PRODRION_API_HOST=127.0.0.1          # use 0.0.0.0 in production, behind nginx
PRODRION_API_PORT=8000
PRODRION_DB_PATH=feedback_platform.db

# ---- API security ----
# Bearer token for the admin/query endpoints (/query, /revenue-impact,
# /bootstrap-taxonomy, /taxonomy, /import-users) and the repo-agent server.
# Required in production. Blank in dev = auth disabled (logs a warning).
PRODRION_API_AUTH_TOKEN=
# Comma-separated browser origins allowed to call the API (CORS). e.g.
# https://app.example.com,https://staging.example.com
PRODRION_CORS_ALLOW_ORIGINS=
# Supabase project JWT secret (Settings -> API -> JWT Secret). Verifies the
# dashboard user's access token on the /me/* endpoints. Blank in dev = dev-user.
PRODRION_SUPABASE_JWT_SECRET=
# Direct Postgres connection string for the Supabase project (Settings ->
# Database -> Connection string -> URI). Server-only: lets the backend read
# per-workspace hooks/sync_settings and write dashboard_stats/suggested_features/
# activity_log/billing usage. Required in production. See supabase_sync.py.
PRODRION_SUPABASE_DB_URL=
# Shared secret required in the X-Webhook-Secret header on POST /webhook/feedback
# (the operator's own/default workspace). Customers post to
# /webhook/feedback/<workspace-id> with their own secret from the dashboard
# (Keys -> Webhook Secret).
# Required in production.
PRODRION_WEBHOOK_SECRET=
# Slack signing secret for POST /webhook/slack signature verification.
# Blank in dev = check skipped; in production the Slack endpoint is disabled.
PRODRION_SLACK_SIGNING_SECRET=
# Max accepted request body size in bytes (default 1 MiB).
PRODRION_MAX_REQUEST_BYTES=1048576
# Hard row cap + wall-clock budget for the /query (text-to-SQL) endpoint.
PRODRION_QUERY_ROW_CAP=100
PRODRION_QUERY_TIMEOUT_SECONDS=5.0
# repo-agent may only analyse directories under this base (blank = bundled repo-agent/).
PRODRION_REPO_AGENT_ALLOWED_BASE=

# ---- Repo fix agent ("Generate fix") ----
# Model turns per job and wall-clock budget. Each turn is one LLM request, so
# on the Gemini free tier this is what your per-minute / per-day quota buys
# (as of 2026-11: 20 requests per model per day on the free tier).
PRODRION_REPO_AGENT_MAX_STEPS=40
PRODRION_REPO_AGENT_TIMEOUT_SECONDS=900
# Customer reports from the bucket shown to the agent.
PRODRION_REPO_AGENT_MAX_REPORTS=8
# May the agent run the customer repo's own tests to verify a fix?
#   off    = never execute repo code; fixes are syntax-checked only (default)
#   docker = run in a locked-down throwaway container (Docker must be installed
#            and the worker's user must be allowed to use it)
#   local  = run directly on this machine; development only, refused in production
PRODRION_REPO_AGENT_SANDBOX=off
PRODRION_REPO_AGENT_SANDBOX_IMAGE=nikolaik/python-nodejs:python3.12-nodejs22
PRODRION_REPO_AGENT_SANDBOX_MEMORY=2g
PRODRION_REPO_AGENT_SANDBOX_CPUS=2
PRODRION_REPO_AGENT_COMMAND_TIMEOUT_SECONDS=300
# Blank = auto-detect (pytest / npm test). Set to override for every repo.
PRODRION_REPO_AGENT_SETUP_COMMAND=
PRODRION_REPO_AGENT_TEST_COMMAND=

# ---- GitHub App (repo read + issue/PR creation) ----
PRODRION_GITHUB_API_URL=https://api.github.com
PRODRION_GITHUB_APP_ID=
# PEM contents, or a path to a .pem file.
PRODRION_GITHUB_APP_PRIVATE_KEY=
# The same App's OAuth "Client ID" / client secret. Enable "Request user
# authorization (OAuth) during installation" in the App settings: the backend
# then verifies the dashboard user can really access the installation they
# link. Required in production whenever PRODRION_GITHUB_APP_ID is set.
PRODRION_GITHUB_APP_CLIENT_ID=
PRODRION_GITHUB_APP_CLIENT_SECRET=
PRODRION_GITHUB_WEBHOOK_SECRET=
PRODRION_GITHUB_CLONE_MAX_BYTES=50000000
PRODRION_GITHUB_CLONE_TIMEOUT_SECONDS=120
PRODRION_GITHUB_CLONE_DIR=var/gh-clones

# ---- Credits / billing ----
PRODRION_CREDITS_ENABLED=false          # true = enforce credit balances
PRODRION_DEFAULT_WORKSPACE_ID=default
PRODRION_CREDITS_PER_FEEDBACK=1
PRODRION_CREDITS_PER_REPO_ANALYSIS=25

# ---- Background worker / job queue ----
PRODRION_WORKER_POLL_INTERVAL_SECONDS=1.0
PRODRION_JOB_MAX_ATTEMPTS=5
PRODRION_JOB_BACKOFF_BASE_SECONDS=5.0     # retry delay = base * 2**(attempt-1)
PRODRION_JOB_BACKOFF_MAX_SECONDS=3600.0
# true = run the worker loop + scheduler inside the API process (dev only);
# in production run `python worker.py` as a separate service.
PRODRION_INLINE_WORKER=false

# ---- LLM / embeddings ----
# Provider for generation: gemini | zai | ollama | fake
# ("fake" is test-only and rejected in production).
PRODRION_LLM_PROVIDER=gemini
# Provider for embeddings: blank = same as PRODRION_LLM_PROVIDER.
# Z.ai is generation-only, so with PRODRION_LLM_PROVIDER=zai set this to gemini.
PRODRION_EMBED_PROVIDER=

# Gemini (free-tier API) — required when PRODRION_LLM_PROVIDER=gemini
PRODRION_GEMINI_API_KEY=
PRODRION_GEMINI_MODEL=gemini-3.8-flash
PRODRION_GEMINI_EMBED_MODEL=gemini-embedding-2

# Z.ai GLM (paid, pay-per-token) — required when PRODRION_LLM_PROVIDER=zai
PRODRION_ZAI_API_KEY=
PRODRION_ZAI_MODEL=glm-5.3
PRODRION_ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# low | high | max. Thinking tokens are billed as output; low is the tested
# default (best results per dollar in our benchmark), max costs the most.
PRODRION_ZAI_REASONING_EFFORT=low

# Ollama (local) — used when PRODRION_LLM_PROVIDER=ollama
PRODRION_OLLAMA_URL=http://localhost:11434/api/generate
PRODRION_OLLAMA_MODEL=llama3.2:latest
PRODRION_OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- Tuning knobs ----
PRODRION_SIMILARITY_THRESHOLD=0.85   # 0..1, feedback<->Jira auto-link cutoff
PRODRION_VELOCITY_SPIKE_MULT=2.0     # week-over-week multiple that fires an alert
PRODRION_DRIFT_MIN_CLUSTER_SIZE=3    # HDBSCAN min cluster size for drift detection

# ---- Demo / bootstrap ----
PRODRION_LOAD_DEMO_DATA=false        # load demo Jira tickets when Jira is unconfigured
# Product docs URL for the DEFAULT (operator's own) workspace only; built
# when its taxonomy is empty. Customer workspaces never use it.
PRODRION_TAXONOMY_BOOTSTRAP_URL=
# A customer workspace with no product areas learns them from its own reviews
# once it has this many (customers can instead give their help-center URL in
# the dashboard: Settings -> Product areas).
PRODRION_TAXONOMY_AUTO_MIN_FEEDBACK=8

# ---- Slack ----
# slack_bot_token here is for admin alerts only (send_slack_alert). The
# per-workspace Zendesk/App Store/Play Store/Slack feedback connectors are
# configured per-customer via the dashboard's Integrations page (the `hooks`
# table), not env vars — see supabase_sync.py / worker.py's poll_tick.
# xoxb-...
PRODRION_SLACK_BOT_TOKEN=
PRODRION_SLACK_ALERT_CHANNEL=#alerts

# ---- Jira / HubSpot (global — admin's own workspace; EMAIL+TOKEN required if URL set) ----
# https://yourco.atlassian.net
PRODRION_JIRA_URL=
PRODRION_JIRA_EMAIL=
PRODRION_JIRA_TOKEN=
PRODRION_JIRA_PROJECT=PROJ
PRODRION_HUBSPOT_API_KEY=

# ---- Bucket builder ----
# Minimum feedback_count in a taxonomy label before rebuild_buckets() surfaces
# it as a suggested fix on the dashboard.
PRODRION_GOAL_MIN_CLUSTER_SIZE=2
