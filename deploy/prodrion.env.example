# Production environment for Prodrion — copy to /etc/prodrion/prodrion.env
# systemd EnvironmentFile format: KEY=VALUE, no inline comments, no `export`.
# Full list of variables + descriptions is in ../.env.example.

PRODRION_ENVIRONMENT=production
PRODRION_API_HOST=127.0.0.1
PRODRION_API_PORT=8000
PRODRION_DB_PATH=/opt/prodrion/var/prodrion.db
PRODRION_SQLITE_BUSY_TIMEOUT_SECONDS=5.0

PRODRION_LOG_LEVEL=INFO
PRODRION_LOG_FORMAT=json
PRODRION_SENTRY_DSN=

PRODRION_API_AUTH_TOKEN=CHANGE_ME_LONG_RANDOM
PRODRION_WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM
PRODRION_SLACK_SIGNING_SECRET=
PRODRION_CORS_ALLOW_ORIGINS=https://app.example.com
PRODRION_SUPABASE_JWT_SECRET=CHANGE_ME_SUPABASE_JWT_SECRET
PRODRION_SUPABASE_DB_URL=CHANGE_ME_SUPABASE_DB_CONNECTION_STRING

PRODRION_LLM_PROVIDER=gemini
PRODRION_GEMINI_API_KEY=CHANGE_ME
PRODRION_GEMINI_MODEL=gemini-2.5-flash
PRODRION_GEMINI_EMBED_MODEL=text-embedding-004

PRODRION_TAXONOMY_BOOTSTRAP_URL=
PRODRION_LOAD_DEMO_DATA=false

PRODRION_CREDITS_ENABLED=false
PRODRION_DEFAULT_WORKSPACE_ID=default
PRODRION_CREDITS_PER_FEEDBACK=1
PRODRION_CREDITS_PER_REPO_ANALYSIS=25

PRODRION_GITHUB_APP_ID=
PRODRION_GITHUB_APP_PRIVATE_KEY=/etc/prodrion/github-app.pem
PRODRION_GITHUB_WEBHOOK_SECRET=
PRODRION_GITHUB_CLONE_DIR=/opt/prodrion/var/gh-clones

PRODRION_INLINE_WORKER=false
